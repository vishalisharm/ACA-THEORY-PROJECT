@@ -686,4 +701,26 @@ class LLBPXTSCL64kTimingOptW : public LLBPX {
 
 
 
+// [PROJECT-MOD] Ablation models used to quantify the contribution of the
+// two LLBP-X optimisations (paper Sec. VII-E). All other parameters are
+// identical to the corresponding upstream LLBP-X model.
+template<bool Timing, bool Depth, bool Range>
+class LLBPXAblation : public LLBPX {
+   public:
+    LLBPXAblation(void)
+        : LLBPX(LLBPXConfig
+            {
+                .tsclConfig = TSCLConfig
+                {
+                    .tageConfig = Tage64kConfig,
+                    .useSC = true,
+                    .useLoop = true
+                },
+                .simulateTiming = Timing,
+                .depthAdaptation = Depth,
+                .histRangeSel = Range,
+            })
+    {}
+};
+
 };  // namespace LLBP
